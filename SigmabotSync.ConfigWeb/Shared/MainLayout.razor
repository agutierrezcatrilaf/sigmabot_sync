@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Fixed="true" Color="Color.Primary" Class="config-app-bar">
        <MudText Typo="Typo.subtitle1" Class="config-app-title">SigmabotSync — Configuración</MudText>
    </MudAppBar>
    <MudMainContent Class="config-main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            AppbarBackground = "#2563EB"
        }
    };
}
