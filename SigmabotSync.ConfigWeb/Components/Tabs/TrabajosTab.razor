@inherits ConfiguratorComponentBase

<MudText Typo="Typo.body2" Class="mb-3">
    Nombre, Tipo y Estado son editables. Periodicidad y control de ejecución también.
</MudText>
<MudStack Row="true" Class="mb-3" Spacing="2" Wrap="Wrap.Wrap">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="State.CargarTrabajos">Cargar</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="State.NuevoTrabajo">Nuevo trabajo</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Guardar">Guardar cambios</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Eliminar">Eliminar seleccionado</MudButton>
</MudStack>

<p class="config-grid-hint">Desplace horizontalmente si necesita ver todas las columnas.</p>
<div class="config-grid-scroll">
    <MudTable Items="@State.Trabajos" Hover="true" Dense="true" Breakpoint="Breakpoint.None"
              Elevation="0" HorizontalScrollbar="false" Square="true"
              Class="config-edit-table" Style="min-width: 1280px;"
              @bind-SelectedItem="State.TrabajoSeleccionado">
        <HeaderContent>
            <MudTh Class="col-id">Id</MudTh>
            <MudTh Class="col-trab-nombre">Nombre</MudTh>
            <MudTh Class="col-trab-tipo">Tipo</MudTh>
            <MudTh Class="col-trab-per">Periodicidad</MudTh>
            <MudTh Class="col-trab-fecha">Última ejecución</MudTh>
            <MudTh Class="col-trab-fecha">Próxima ejecución</MudTh>
            <MudTh Class="col-trab-res">Resultado última</MudTh>
            <MudTh Class="col-trab-ctrl">Control ejecución</MudTh>
            <MudTh Class="col-trab-estado">Estado</MudTh>
            <MudTh Class="col-trab-corr">Últ. corrección</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="col-id">@context.Id</MudTd>
            <MudTd Class="col-trab-nombre">
                <MudTextField @bind-Value="context.Nombre" Margin="Margin.Dense" Variant="Variant.Text" FullWidth="true" />
            </MudTd>
            <MudTd Class="col-trab-tipo">
                <MudSelect T="string" @bind-Value="context.Tipo" Margin="Margin.Dense" Dense="true" Variant="Variant.Text" FullWidth="true">
                    @foreach (var t in State.TiposTrabajoParaEditor)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd Class="col-trab-per">
                <MudTextField @bind-Value="context.Perioricidad" Margin="Margin.Dense" Variant="Variant.Text" FullWidth="true" />
            </MudTd>
            <MudTd Class="col-trab-fecha">@(context.FechaUltimaEjecucion?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
            <MudTd Class="col-trab-fecha">@(context.FechaProximaEjecucion?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
            <MudTd Class="col-trab-res">@context.ResultadoUltimaEjecucion</MudTd>
            <MudTd Class="col-trab-ctrl">
                <MudTextField @bind-Value="context.ControldeEjecucion" Margin="Margin.Dense" Variant="Variant.Text" FullWidth="true" />
            </MudTd>
            <MudTd Class="col-trab-estado">
                <MudSelect T="string" @bind-Value="context.Estado" Margin="Margin.Dense" Dense="true" Variant="Variant.Text" FullWidth="true">
                    @foreach (var e in State.EstadosTrabajoParaEditor)
                    {
                        <MudSelectItem Value="@e">@e</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd Class="col-trab-corr">@context.UltCorrEjecucion</MudTd>
        </RowTemplate>
    </MudTable>
</div>

@code {
    private Task Guardar() => State.GuardarTrabajosAsync();
    private Task Eliminar() => State.EliminarTrabajoSeleccionadoAsync();
}
