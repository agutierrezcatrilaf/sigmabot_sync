<?xml version="1.0" encoding="utf-8"?>
<!-- Solo para probar si falta URL Rewrite. Sin esto, /credenciales al refrescar puede dar 404. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
