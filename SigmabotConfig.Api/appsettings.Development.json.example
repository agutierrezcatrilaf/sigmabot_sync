{
  "Database": {
    "ConnectionString": "Server=YOUR_SERVER;Database=sigmabot;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Credenciales": {
    "EncryptionKey": "GENERATE_32_BYTES_BASE64"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "WorkerLogs": {
    "AllowedDirectories": [
      "C:\\path\\to\\SigmabotSync.Worker\\SigmabotSync.Console\\bin\\Debug\\net8.0\\Logs"
    ]
  },
  "OnDemandExecution": {
    "Enabled": false,
    "WorkerExePath": "C:\\path\\to\\SigmabotSync.Console.exe"
  }
}
